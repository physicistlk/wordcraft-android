+impl Drop for ProtocolSource {
+    fn drop(&mut self) {
+        match self {
+            Self::Regular(source) => {
+                if source.is_alive() {
+                    source.destroy();
+                }
+            },
+            // Dropping the wrapper destroys the PRIMARY protocol object.
+            Self::Primary(_) => {},
+        }
+    }
