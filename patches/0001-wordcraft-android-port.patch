+/// One protocol source that is being installed, or `None` for a detached (test) claim.
+struct ClaimInstall {
+    kind: SelectionKind,
+    token: u64,
+    marker: String,
+    payload: OwnedPayload,
+    target_window: WindowId,
+    caller_generation: u64,
