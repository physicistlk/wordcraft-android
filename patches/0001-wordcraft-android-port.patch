+impl Drop for RaiiIcon {
+    fn drop(&mut self) {
+        unsafe { DestroyIcon(self.handle) };
+    }
+}
+
+impl fmt::Debug for WinIcon {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> Result<(), fmt::Error> {
+        (*self.inner).fmt(formatter)
+    }
+}
+
+pub fn unset_for_window(hwnd: HWND, icon_type: IconType) {
+    unsafe {
+        SendMessageW(hwnd, WM_SETICON, icon_type as usize, 0);
+    }
+}
+
+#[derive(Debug, Clone)]
+pub enum SelectedCursor {
+    Named(CursorIcon),
+    Custom(Arc<RaiiCursor>),
+}
+
+impl Default for SelectedCursor {
+    fn default() -> Self {
+        Self::Named(Default::default())
+    }
+}
+
+#[derive(Clone, Debug, Hash, Eq, PartialEq)]
+pub enum WinCursor {
+    Cursor(Arc<RaiiCursor>),
+    Failed,
+}
+
+impl WinCursor {
+    pub(crate) fn new(image: &CursorImage) -> Result<Self, io::Error> {
+        let mut bgra = image.rgba.clone();
+        bgra.chunks_exact_mut(4).for_each(|chunk| chunk.swap(0, 2));
+
+        let w = image.width as i32;
+        let h = image.height as i32;
+
+        unsafe {
+            let hdc_screen = GetDC(0);
+            if hdc_screen == 0 {
+                return Err(io::Error::last_os_error());
+            }
+            let hbm_color = CreateCompatibleBitmap(hdc_screen, w, h);
+            ReleaseDC(0, hdc_screen);
+            if hbm_color == 0 {
+                return Err(io::Error::last_os_error());
+            }
+            if SetBitmapBits(hbm_color, bgra.len() as u32, bgra.as_ptr() as *const c_void) == 0 {
+                DeleteObject(hbm_color);
+                return Err(io::Error::last_os_error());
+            };
+
+            // Mask created according to https://learn.microsoft.com/en-us/windows/win32/api/wingdi/nf-wingdi-createbitmap#parameters
+            let mask_bits: Vec<u8> = vec![0xff; ((((w + 15) >> 4) << 1) * h) as usize];
+            let hbm_mask = CreateBitmap(w, h, 1, 1, mask_bits.as_ptr() as *const _);
+            if hbm_mask == 0 {
+                DeleteObject(hbm_color);
+                return Err(io::Error::last_os_error());
+            }
+
+            let icon_info = ICONINFO {
+                fIcon: 0,
+                xHotspot: image.hotspot_x as u32,
+                yHotspot: image.hotspot_y as u32,
+                hbmMask: hbm_mask,
+                hbmColor: hbm_color,
+            };
+
+            let handle = CreateIconIndirect(&icon_info as *const _);
+            DeleteObject(hbm_color);
+            DeleteObject(hbm_mask);
+            if handle == 0 {
+                return Err(io::Error::last_os_error());
+            }
+
+            Ok(Self::Cursor(Arc::new(RaiiCursor { handle })))
+        }
+    }
+}
+
+#[derive(Debug, Hash, Eq, PartialEq)]
+pub struct RaiiCursor {
+    handle: HCURSOR,
+}
+
+impl Drop for RaiiCursor {
+    fn drop(&mut self) {
+        unsafe { DestroyCursor(self.handle) };
+    }
+}
+
+impl RaiiCursor {
+    pub fn as_raw_handle(&self) -> HICON {
+        self.handle
+    }
+}
diff --git a/vendor/winit/src/platform_impl/windows/ime.rs b/vendor/winit/src/platform_impl/windows/ime.rs
new file mode 100644
index 00000000..24131d9a
--- /dev/null
+++ b/vendor/winit/src/platform_impl/windows/ime.rs
@@ -0,0 +1,236 @@
+use std::ffi::{c_void, OsString};
+use std::os::windows::prelude::OsStringExt;
+use std::ptr::null_mut;
+
+use windows_sys::Win32::Foundation::{POINT, RECT};
+use windows_sys::Win32::Globalization::HIMC;
+use windows_sys::Win32::UI::Input::Ime::{
+    ImmAssociateContextEx, ImmGetCompositionStringW, ImmGetContext, ImmNotifyIME,
+    ImmReleaseContext, ImmSetCandidateWindow, ImmSetCompositionWindow, ATTR_TARGET_CONVERTED,
+    ATTR_TARGET_NOTCONVERTED, CANDIDATEFORM, CFS_EXCLUDE, CFS_POINT, COMPOSITIONFORM, CPS_CANCEL,
+    GCS_COMPATTR, GCS_COMPSTR, GCS_CURSORPOS, GCS_RESULTSTR, IACE_CHILDREN, IACE_DEFAULT,
+    NI_COMPOSITIONSTR,
+};
+use windows_sys::Win32::UI::WindowsAndMessaging::{
+    CreateCaret, DestroyCaret, GetSystemMetrics, SetCaretPos, SM_IMMENABLED,
+};
+
+use crate::dpi::{Position, Size};
+use crate::platform::windows::HWND;
+use crate::platform_impl::platform::ime_caret::CaretChange;
+
+pub struct ImeContext {
+    hwnd: HWND,
+    himc: HIMC,
+}
+
+impl ImeContext {
+    pub unsafe fn current(hwnd: HWND) -> Self {
+        let himc = unsafe { ImmGetContext(hwnd) };
+        ImeContext { hwnd, himc }
+    }
+
+    /// `composition_flags` is the `lParam` of the `WM_IME_COMPOSITION` message.
+    pub unsafe fn get_composing_text_and_cursor(
+        &self,
+        composition_flags: u32,
+    ) -> Option<(String, Option<usize>, Option<usize>)> {
+        let text = unsafe { self.get_composition_string(GCS_COMPSTR) }?;
+        let attrs = unsafe { self.get_composition_data(GCS_COMPATTR) }.unwrap_or_default();
+
+        let mut first = None;
+        let mut last = None;
+        let mut boundary_before_char = 0;
+        let mut attr_idx = 0;
+
+        for chr in text.chars() {
+            let Some(attr) = attrs.get(attr_idx).copied() else {
+                break;
+            };
+
+            let char_is_targeted =
+                attr as u32 == ATTR_TARGET_CONVERTED || attr as u32 == ATTR_TARGET_NOTCONVERTED;
+
+            if first.is_none() && char_is_targeted {
+                first = Some(boundary_before_char);
+            } else if first.is_some() && last.is_none() && !char_is_targeted {
+                last = Some(boundary_before_char);
+            }
+
+            boundary_before_char += chr.len_utf8();
+            attr_idx += chr.len_utf16();
+        }
+
+        if first.is_some() && last.is_none() {
+            last = Some(text.len());
+        } else if first.is_none() {
+            // IME haven't split words and select any clause yet, so trying to retrieve normal
+            // cursor.
+            // WordCraft patch: read `GCS_CURSORPOS` only when `WM_IME_COMPOSITION` says it is set,
+            // else put the cursor at the end (rust-windowing/winit#4746). The Microsoft Korean IME
+            // never sets it, so the cursor read as 0 and was drawn before the syllable being
+            // composed, with the candidate window there too.
+            let cursor = if composition_flags & GCS_CURSORPOS != 0 {
+                unsafe { self.get_composition_cursor(&text) }
+            } else {
+                Some(text.len())
+            };
+            first = cursor;
+            last = cursor;
+        }
+
+        Some((text, first, last))
+    }
+
+    pub unsafe fn get_composed_text(&self) -> Option<String> {
+        unsafe { self.get_composition_string(GCS_RESULTSTR) }
+    }
+
+    unsafe fn get_composition_cursor(&self, text: &str) -> Option<usize> {
+        let cursor = unsafe { ImmGetCompositionStringW(self.himc, GCS_CURSORPOS, null_mut(), 0) };
+        (cursor >= 0).then(|| text.chars().take(cursor as _).map(|c| c.len_utf8()).sum())
+    }
+
+    unsafe fn get_composition_string(&self, gcs_mode: u32) -> Option<String> {
+        let data = unsafe { self.get_composition_data(gcs_mode) }?;
+        let (prefix, shorts, suffix) = unsafe { data.align_to::<u16>() };
+        if prefix.is_empty() && suffix.is_empty() {
+            OsString::from_wide(shorts).into_string().ok()
+        } else {
+            None
+        }
+    }
+
+    unsafe fn get_composition_data(&self, gcs_mode: u32) -> Option<Vec<u8>> {
+        let size = match unsafe { ImmGetCompositionStringW(self.himc, gcs_mode, null_mut(), 0) } {
+            0 => return Some(Vec::new()),
+            size if size < 0 => return None,
+            size => size,
+        };
+
+        let mut buf = Vec::<u8>::with_capacity(size as _);
+        let size = unsafe {
+            ImmGetCompositionStringW(
+                self.himc,
+                gcs_mode,
+                buf.as_mut_ptr() as *mut c_void,
+                size as _,
+            )
+        };
+
+        if size < 0 {
+            None
+        } else {
+            unsafe { buf.set_len(size as _) };
+            Some(buf)
+        }
+    }
+
+    pub unsafe fn set_ime_cursor_area(&self, spot: Position, size: Size, scale_factor: f64) {
+        if !unsafe { ImeContext::system_has_ime() } {
+            return;
+        }
+
+        let (x, y) = spot.to_physical::<i32>(scale_factor).into();
+        let (width, height): (i32, i32) = size.to_physical::<i32>(scale_factor).into();
+        let rc_area = RECT { left: x, top: y, right: x + width, bottom: y + height };
+        let candidate_form = CANDIDATEFORM {
+            dwIndex: 0,
+            dwStyle: CFS_EXCLUDE,
+            ptCurrentPos: POINT { x, y },
+            rcArea: rc_area,
+        };
+        let composition_form = COMPOSITIONFORM {
+            dwStyle: CFS_POINT,
+            ptCurrentPos: POINT { x, y: y + height },
+            rcArea: rc_area,
+        };
+
+        unsafe {
+            ImmSetCompositionWindow(self.himc, &composition_form);
+            ImmSetCandidateWindow(self.himc, &candidate_form);
+        }
+    }
+
+    /// Asks the IME to discard the composition (`NI_COMPOSITIONSTR`, `CPS_CANCEL`). Which
+    /// composition messages the IME sends in response, if any, depends on the IME.
+    pub unsafe fn cancel_composition(&self) -> bool {
+        unsafe { ImmNotifyIME(self.himc, NI_COMPOSITIONSTR, CPS_CANCEL, 0) != 0 }
+    }
+
+    /// Establishes cancellation, including a successful empty-context no-op. CPS_CANCEL's
+    /// boolean return is not documented to distinguish "already empty" from a failure.
+    pub unsafe fn reset_composition(&self) -> bool {
+        if self.himc == 0 {
+            return false;
+        }
+        let size = unsafe { ImmGetCompositionStringW(self.himc, GCS_COMPSTR, null_mut(), 0) };
+        composition_reset_succeeded(size, || unsafe { self.cancel_composition() })
+    }
+
+    pub unsafe fn set_ime_allowed(hwnd: HWND, allowed: bool) {
+        if !unsafe { ImeContext::system_has_ime() } {
+            return;
+        }
+
+        if allowed {
+            unsafe { ImmAssociateContextEx(hwnd, 0, IACE_DEFAULT) };
+        } else {
+            unsafe { ImmAssociateContextEx(hwnd, 0, IACE_CHILDREN) };
+        }
+    }
+
+    /// Applies a change to the hidden system caret that follows the IME cursor area
+    /// (`ime_caret.rs`). Runs on the window's thread, which owns the caret.
+    pub unsafe fn update_system_caret(hwnd: HWND, change: Option<CaretChange>) {
+        match change {
+            None => {},
+            // A new caret is hidden, and this one is never shown.
+            Some(CaretChange::Create(area)) => unsafe {
+                if CreateCaret(hwnd, 0, area.width, area.height) != 0 {
+                    SetCaretPos(area.x, area.y);
+                }
+            },
+            Some(CaretChange::Move(area)) => unsafe {
+                SetCaretPos(area.x, area.y);
+            },
+            Some(CaretChange::Destroy) => unsafe {
+                DestroyCaret();
+            },
+        }
+    }
+
+    unsafe fn system_has_ime() -> bool {
+        unsafe { GetSystemMetrics(SM_IMMENABLED) != 0 }
+    }
+}
+
+fn composition_reset_succeeded(size: i32, cancel: impl FnOnce() -> bool) -> bool {
+    // Zero is a successful empty-string query. Negative IMM_ERROR_NODATA/GENERAL values are
+    // not evidence of an empty context; they still require a successful cancellation.
+    size == 0 || cancel()
+}
+
+impl Drop for ImeContext {
+    fn drop(&mut self) {
+        unsafe { ImmReleaseContext(self.hwnd, self.himc) };
+    }
+}
+
+#[cfg(test)]
+mod reset_tests {
+    use super::composition_reset_succeeded;
+
+    #[test]
+    fn empty_context_reset_is_a_noop_even_if_cancel_would_report_false() {
+        assert!(composition_reset_succeeded(0, || panic!("empty context must not need notify")));
+    }
+
+    #[test]
+    fn nonempty_or_unavailable_context_needs_successful_cancellation() {
+        for size in [2, -1, -2] {
+            assert!(!composition_reset_succeeded(size, || false));
+            assert!(composition_reset_succeeded(size, || true));
+        }
+    }
+}
diff --git a/vendor/winit/src/platform_impl/windows/ime_caret.rs b/vendor/winit/src/platform_impl/windows/ime_caret.rs
new file mode 100644
index 00000000..91d93cd8
--- /dev/null
+++ b/vendor/winit/src/platform_impl/windows/ime_caret.rs
@@ -0,0 +1,122 @@
+//! When a window keeps a hidden system caret at the IME cursor area.
+//!
+//! Some IMEs place their composition and candidate windows at the system caret
+//! (`GetCaretPos`, `GetGUIThreadInfo`) and ignore `ImmSetCandidateWindow`: Sogou, and some
+//! Japanese IMEs. A window that has the keyboard focus and allows IME keeps a hidden caret over
+//! the last IME cursor area. Windows has one caret per thread, and a window must destroy it before
+//! it loses the focus.
+//!
+//! This is plain Rust so that its tests run on every platform (`tests/ime_patches.rs`).
+
+/// An IME cursor area in physical client coordinates. Both sides are at least 1.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct CaretArea {
+    pub x: i32,
+    pub y: i32,
+    pub width: i32,
+    pub height: i32,
+}
+
+impl CaretArea {
+    pub fn new(x: i32, y: i32, width: i32, height: i32) -> Self {
+        CaretArea { x, y, width: width.max(1), height: height.max(1) }
+    }
+}
+
+/// What to do with the thread's system caret.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CaretChange {
+    /// `CreateCaret` at this size, then `SetCaretPos`. It replaces any caret the thread has.
+    Create(CaretArea),
+    /// `SetCaretPos`.
+    Move(CaretArea),
+    /// `DestroyCaret`.
+    Destroy,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct SystemCaret {
+    focused: bool,
+    ime_allowed: bool,
+    area: Option<CaretArea>,
+    /// The caret this window has created, if any.
+    current: Option<CaretArea>,
+}
+
+impl SystemCaret {
+    pub fn set_focused(&mut self, focused: bool) -> Option<CaretChange> {
+        self.focused = focused;
+        self.update()
+    }
+
+    pub fn set_ime_allowed(&mut self, allowed: bool) -> Option<CaretChange> {
+        self.ime_allowed = allowed;
+        self.update()
+    }
+
+    pub fn set_area(&mut self, area: CaretArea) -> Option<CaretChange> {
+        self.area = Some(area);
+        self.update()
+    }
+
+    fn update(&mut self) -> Option<CaretChange> {
+        let wanted = self.area.filter(|_| self.focused && self.ime_allowed);
+        match (std::mem::replace(&mut self.current, wanted), wanted) {
+            (None, None) => None,
+            (Some(_), None) => Some(CaretChange::Destroy),
+            (None, Some(new)) => Some(CaretChange::Create(new)),
+            (Some(old), Some(new)) if old == new => None,
+            (Some(old), Some(new)) if (old.width, old.height) == (new.width, new.height) => {
+                Some(CaretChange::Move(new))
+            },
+            (Some(_), Some(new)) => Some(CaretChange::Create(new)),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn caret_exists_only_while_focused_with_ime_allowed() {
+        let area = CaretArea::new(10, 20, 2, 16);
+        let mut caret = SystemCaret::default();
+        assert_eq!(caret.set_area(area), None);
+        assert_eq!(caret.set_focused(true), None);
+        assert_eq!(caret.set_ime_allowed(true), Some(CaretChange::Create(area)));
+        assert_eq!(caret.set_focused(false), Some(CaretChange::Destroy));
+        assert_eq!(caret.set_focused(true), Some(CaretChange::Create(area)));
+        assert_eq!(caret.set_ime_allowed(false), Some(CaretChange::Destroy));
+        assert_eq!(caret.set_ime_allowed(false), None);
+    }
+
+    #[test]
+    fn caret_waits_for_a_cursor_area() {
+        let mut caret = SystemCaret::default();
+        assert_eq!(caret.set_focused(true), None);
+        assert_eq!(caret.set_ime_allowed(true), None);
+        let area = CaretArea::new(0, 0, 1, 18);
+        assert_eq!(caret.set_area(area), Some(CaretChange::Create(area)));
+    }
+
+    #[test]
+    fn caret_follows_the_cursor_area() {
+        let mut caret = SystemCaret::default();
+        caret.set_focused(true);
+        caret.set_ime_allowed(true);
+        let first = CaretArea::new(10, 20, 1, 16);
+        assert_eq!(caret.set_area(first), Some(CaretChange::Create(first)));
+        assert_eq!(caret.set_area(first), None);
+        let moved = CaretArea::new(30, 20, 1, 16);
+        assert_eq!(caret.set_area(moved), Some(CaretChange::Move(moved)));
+        // A caret's size is fixed when it is created.
+        let taller = CaretArea::new(30, 20, 1, 24);
+        assert_eq!(caret.set_area(taller), Some(CaretChange::Create(taller)));
+    }
+
+    #[test]
+    fn caret_area_is_never_empty() {
+        assert_eq!(CaretArea::new(5, 6, 0, -3), CaretArea { x: 5, y: 6, width: 1, height: 1 });
+    }
+}
