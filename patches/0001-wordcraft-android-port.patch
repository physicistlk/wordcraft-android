+        self.shared_state_lock().min_inner_size = dimensions;
+        let physical_dimensions =
+            dimensions.map(|dimensions| dimensions.to_physical::<u32>(self.scale_factor()).into());
+        self.set_min_inner_size_physical(physical_dimensions);
+    }
