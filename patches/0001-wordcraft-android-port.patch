+    );
+    let window = source("linux/wayland/window/mod.rs");
+    let cursor = section(&window, "pub fn set_ime_cursor_area(", "\n    }\n");
+    assert!(
+        !cursor.contains("if window_state.ime_allowed()"),
+        "a cursor area set while IME is disabled is discarded"
+    );
