+            (ClipboardError::Busy, ErrorKind::WouldBlock),
+            (ClipboardError::TooLarge, ErrorKind::InvalidData),
+            (ClipboardError::InvalidInput, ErrorKind::InvalidInput),
+            (ClipboardError::Disconnected, ErrorKind::BrokenPipe),
