+    {
+        x11_or_wayland!(match self; EventLoop(evlp) => evlp.pump_events(timeout, callback))
+    }
+
+    pub fn window_target(&self) -> &crate::event_loop::ActiveEventLoop {
+        x11_or_wayland!(match self; EventLoop(evlp) => evlp.window_target())
+    }
+}
