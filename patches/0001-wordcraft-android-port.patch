+        assert!(!seat.validates(
+            &replacement_token.inner,
+            target,
+            SelectionKind::Regular,
+            now + Duration::from_millis(9)
+        ));
+        assert!(replacement.validates(
+            &replacement_token.inner,
+            target,
+            SelectionKind::Regular,
+            now + Duration::from_millis(9)
+        ));
+    }
