+    #[inline]
+    pub fn outer_position(&self) -> Result<PhysicalPosition<i32>, NotSupportedError> {
+        util::WindowArea::Outer
+            .get_rect(self.hwnd())
+            .map(|rect| Ok(PhysicalPosition::new(rect.left, rect.top)))
