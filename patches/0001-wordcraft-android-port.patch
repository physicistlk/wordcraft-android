+    fn toggle_style_mask(&self, mask: NSWindowStyleMask, on: bool) {
+        let current_style_mask = self.window().styleMask();
+        if on {
+            self.set_style_mask(current_style_mask | mask);
+        } else {
+            self.set_style_mask(current_style_mask & !mask);
+        }
+    }
