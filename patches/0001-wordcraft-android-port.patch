+impl fmt::Debug for ImageClaimReservation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match &self.inner {
+            Some(inner) => f
+                .debug_struct("ImageClaimReservation")
+                .field("target_window", &inner.target_window)
+                .field("serial", &inner.serial)
